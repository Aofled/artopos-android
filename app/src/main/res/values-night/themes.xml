<resources>
    <!-- 1. Base theme for Compose  -->
    <style name="Theme.Artopos" parent="android:Theme.Material.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- 2. Splash Screen Theme -->
    <style name="Theme.Artopos.Starting" parent="Theme.SplashScreen">
        <!-- Splash screen background color -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Logo -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- The theme that will be applied AFTER the splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.Artopos</item>
    </style>
</resources>
